# Manifest for src/components/icons/listIcons.h — regenerate with:
#   python3 <freeink-sdk>/libs/assets/Icons/tools/gen_icons.py \
#     --manifest src/components/icons/listIcons.manifest \
#     --svgdir <freeink-sdk>/libs/assets/Icons/lucide/icons \
#     --sizes 24,32 --out src/components/icons/listIcons.h
# then clang-format -i the output.
folder = folder
file-text = file-text
image = image
book = book
file = file
wifi = wifi
library = library
radio-tower = radio-tower
sun = sun
moon = moon
# sun-filled / moon-filled are not stock Lucide: copy sun.svg / moon.svg and add
# fill="currentColor" to the <circle> (sun) / the single <path> (moon), drop the
# copies into the svgdir, then regenerate. No permanent SVG source is kept.
sun-filled = sun-filled
moon-filled = moon-filled
upload = upload
download = download
