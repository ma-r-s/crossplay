   -DCROSSPOINT_VERSION=\"${crossplay.version}\"
   -DLOG_LEVEL=1
 
+; --- LilyGo T5 E-Paper S3 Pro Lite (H752-01) — ESP32-S3, 4.7" ED047TC1 raw-------
+; parallel EPD (960x540, 16-gray) driven through LovyanGFX/M5GFX (BoardConfig's
+; FREEINK_DRIVER_LGFX_EPD, gated behind FREEINK_DEVICE_LILYGO), not a controller
+; chip like the X4 Pro's SSD1677. The board's TPS65185 PMIC + PCA9535 IO expander
+; power sequence is already implemented and hardware-validated in the SDK's own
+; BoardT5S3 lib (freeink-sdk/libs/hardware/BoardT5S3, notably
+; LilyGoT5S3LgfxConfig.cpp) -- no board-support code needed in this repo, unlike
+; Paper Mono's M5PM1/M5IOE1 arrangement below. CAP_TOUCH (GT911), CAP_FRONTLIGHT
+; (BL_EN PWM), CAP_RTC (PCF8563) and the I2C battery gauge (BQ27220 + BQ25896)
+; all auto-enable from FREEINK_DEVICE_LILYGO in BoardConfig.h.
+;
+; qio flash mode / qio_opi memory type + BOARD_HAS_PSRAM match the vendor's own
+; board file (T5-ePaper-S3.json: qio, qio_opi, 16MB, BOARD_HAS_PSRAM) and are
+; required regardless -- LgfxEpdDriver's grayscale canvas is a PSRAM sprite
+; (LgfxEpdDriver.cpp, setPsram(true)). FREEINK_CAP_USB_MSC=1 matches the SDK's
+; own comment that "X4 Pro and LilyGo T5 S3 both ship that way in CrossPoint"
+; (BoardConfig.h, USB_MSC section), so this extends base (not firmware_tuned):
+; USB-MSC needs the platform's prebuilt TinyUSB component, which the
+; firmware_tuned custom core rebuild omits.
+;   pio run -e lilygo_t5s3 -t upload
+[lilygo_t5s3_common]
+extends = base
+board = esp32-s3-devkitc1-n16r8
+board_build.mcu = esp32s3
+board_build.flash_mode = qio
+board_build.arduino.memory_type = qio_opi
+build_flags =
+  ${base.build_flags}
+  -DFREEINK_DEVICE_LILYGO=1
+  -DFREEINK_CAP_USB_MSC=1
+  -DBOARD_HAS_PSRAM
+  ; Same render-task stack as x4pro_common/sticky_common: this board runs the
+  ; same FreeInkUI screens through the same renderer, and stack_budget.py reads
+  ; the first -DCROSSPOINT_RENDER_TASK_STACK match in this file for all three.
+  -DCROSSPOINT_RENDER_TASK_STACK=16384
+  -DENABLE_SERIAL_LOG
+lib_deps =
+  ${base.lib_deps}
+  BoardT5S3=symlink://freeink-sdk/libs/hardware/BoardT5S3
+  m5stack/M5GFX @ 0.2.24
+
+[env:lilygo_t5s3]
+extends = lilygo_t5s3_common
+build_flags =
+  ${lilygo_t5s3_common.build_flags}
+  -DCROSSPOINT_VERSION=\"${crosspoint.version}-lilygo_t5s3\"
+  -DLOG_LEVEL=2
+  -DCROSSPLAY_TIMER_WAKE_SECONDS=21600
+  ; Host-driven taps/buttons/screenshots over the board's serial transport
+  ; (lib/DevInput, src/DevSerialBridge*, tools_local/device/drive.py).
+  ; Dev builds only; never in a release env.
+  -DCROSSPOINT_DEV_SERIAL_BRIDGE=1
+
+; What a tag builds for the T5S3, alongside gh_release_x4pro and
+; gh_release_sticky. Identical to lilygo_t5s3 except the log level; see
+; gh_release_x4pro for why the fork's release envs exist at all.
+[env:gh_release_lilygo_t5s3]
+extends = lilygo_t5s3_common
+build_flags =
+  ${lilygo_t5s3_common.build_flags}
+  -DCROSSPOINT_VERSION=\"${crossplay.version}\"
+  -DLOG_LEVEL=1
+
 ; --- M5Stack Paper Mono — ESP32-S3, SSD1683 800x480 + FT6336 touch + frontlight
 ; Power/reset plumbing runs through the M5PM1 PMIC and M5IOE1 expander; the SDK
 ; sequences them itself. Touch, frontlight, RTC, and other capabilities are
